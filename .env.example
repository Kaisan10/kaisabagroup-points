# データベース接続設定
DB_USER=kaisaba_user
DB_PASSWORD=your_password
DB_HOST=localhost
DB_PORT=5432
DB_NAME=kaisaba_points

# セッション管理用シークレット (ランダムな文字列を設定)
SESSION_SECRET=your_secure_session_secret

# Discourse 等のWebhook/SSO用シークレット
DISCOURSE_SECRET=your_discourse_secret
WEBHOOK_SECRET=your_webhook_secret

# アプリケーション起動ポート (デフォルトは3000)
PORT=3000

# 手数料の振込先サービスアカウント名
SERVICE_ACCOUNT_FEE_RECIPIENT=your_fee_recipient_service_account_name
