<!-- 通報モーダル -->
<div class="modal-backdrop" id="report-modal">
  <div class="modal-box">
    <div class="modal__title">
      <i class="fa-solid fa-flag text-danger"></i>
      通報する
      <button class="modal__close" id="report-modal-close" type="button" aria-label="閉じる">
        <i class="fa-solid fa-xmark"></i>
      </button>
    </div>
    <form id="report-form">
      <div class="form-group">
        <label class="form-label" for="report-category">
          カテゴリ <span class="text-danger">*</span>
        </label>
        <select class="form-input form-select" id="report-category" required>
          <option value="">選択してください</option>
          <option value="scam">詐欺</option>
          <option value="other">その他</option>
        </select>
      </div>
      <div class="form-group">
        <label class="form-label" for="report-desc">
          詳細 <span class="text-danger">*</span>
          <span class="text-muted">（20文字以上）</span>
        </label>
        <textarea class="form-input form-input--box" id="report-desc" rows="4" placeholder="どのような問題が起きたか詳しく教えてください"
          maxlength="2000"></textarea>
      </div>
      <div class="alert" id="report-msg"></div>
      <p class="text-muted" style="font-size:13px;">管理者がかい鯖グループフォーラムでDMをする可能性があります。(情報を確認するため)</p>
      <div class="modal__actions">
        <button type="button" class="btn btn--ghost" id="report-cancel-btn">キャンセル</button>
        <button class="btn btn--danger" id="report-submit-btn" type="submit">
          <i class="fa-solid fa-flag"></i> 送信する
        </button>
      </div>
    </form>
  </div>
</div>
